# OPENAI_REASONING_EFFORT=low
AGENT_HOST=127.0.0.1
AGENT_PORT=3001

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_API_VERSION=v1beta
