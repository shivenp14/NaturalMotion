# Public configuration only. Values with EXPO_PUBLIC_ are bundled into the app.
# Set this to your backend's LAN address when testing from a physical phone.
# Never use localhost to reach your laptop from the phone.
# Android emulator → local development backend:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001
# Physical phone: use a reachable LAN address or HTTPS backend.
# Never put long-lived model or speech-provider secrets here.
