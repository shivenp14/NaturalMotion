# Public configuration only. EXPO_PUBLIC_* values are bundled into the app.
# On an Android phone, use your laptop's reachable LAN IP, not localhost.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8787

# Server-only environment variables (export in the laptop shell, NOT Expo):
# OPENAI_API_KEY=...  (NEVER commit)
# OPENAI_MODEL=gpt-4.1-mini
# AGENT_HOST=127.0.0.1  (default; set 0.0.0.0 only on a trusted LAN)
# AGENT_PORT=8787
