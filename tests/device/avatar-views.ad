context platform=android
open "${APP_ID}" "${LIVE_URL}"
wait 'id="live-stopped"' 15000
scroll down --until 'id="anatomy-view-status"'
wait absent 'id="anatomy-view-front"' 1000
wait absent 'id="anatomy-view-back"' 1000
wait absent 'id="anatomy-view-side"' 1000
wait absent 'id="anatomy-view-left_side"' 1000
wait absent 'id="anatomy-view-auto"' 1000
wait absent 'text="Region focus"' 1000
wait absent 'text="Upper back"' 1000
wait absent 'text="Shoulders"' 1000
