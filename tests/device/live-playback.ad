context platform=android
open "${APP_ID}" "${LIVE_URL}"
wait 'id="live-stopped"' 15000
scroll up --until 'id="live-text-test-start"'
press 'id="live-text-test-start"'
wait 'id="live-connected"' 20000
scroll down --until 'id="live-request"'
fill 'id="live-request"' "Demonstrate one wall angel: five seconds up, hold for one second, five seconds back, and finish at goalpost."
keyboard dismiss
scroll down --until 'id="live-send"'
press 'id="live-send"'
wait 'id="live-playback-active"' 30000
scroll top
scroll down --until 'id="live-pause"'
press 'id="live-pause"'
wait 'id="live-playback-paused"' 5000
scroll down --until 'id="live-request"'
fill 'id="live-request"' "Show me the back of the model."
keyboard dismiss
scroll down --until 'id="live-send"'
press 'id="live-send"'
scroll up --until 'id="anatomy-view-status"'
wait 'id="anatomy-view-back-back-settled"' 20000
wait 'id="live-playback-paused"' 5000
scroll down --until 'id="live-resume"'
press 'id="live-resume"'
wait 'id="live-playback-active"' 5000
wait 'id="live-playback-completed"' 30000
scroll down --until 'id="live-practice-waiting"'
wait 'id="live-form-demonstration"' 10000
wait 'id="live-connected"' 5000
scroll down --until 'id="live-clear"'
press 'id="live-clear"'
wait 'id="live-playback-idle"' 5000
press 'id="live-end"'
wait 'id="live-stopped"' 15000
wait absent 'id="live-camera"' 5000
