{
  "expo": {
    "name": "NaturalMotion",
    "slug": "naturalmotion",
    "scheme": "naturalmotion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shivenp14.naturalmotion"
    },
    "android": {
      "package": "com.shivenp14.naturalmotion",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NaturalMotion to hear your movement requests.",
          "speechRecognitionPermission": "Allow NaturalMotion to transcribe your speech."
        }
      ]
    ]
  }
}
